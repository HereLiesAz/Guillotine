<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AI providers (BYO key) are called directly over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice-command editing: capture a spoken instruction, transcribe it on-device, run the agent. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- AdMob advertising identifier (app-open ad). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Google Play Billing (Ad-Free). -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Run long video operations (analysis / generative removal / export) in the background with a
         progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Run on Chromebooks / large screens without a touchscreen or hard keyboard. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.freeform_window_management" android:required="false" />

    <!-- Package-visibility (Android 11+) declaration so PackageManager.resolveActivity can see whatever
         Azphalt Store app is installed (azphalt spec/store-app.md's delegated-acquisition handoff) —
         without this, the custom action is invisible to us even when a store app implements it. -->
    <queries>
        <intent>
            <action android:name="store.azphalt.action.BROWSE" />
        </intent>
        <!-- The Play Store app itself, so the "get the Azphalt Store app" fallback's market:// intent
             resolves reliably instead of silently behaving as if Play isn't installed. -->
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:name=".GuillotineApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Guillotine">

        <!-- Optional OpenCL libs used by the on-device LLM (MediaPipe LLM Inference) GPU backend. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />

        <!-- AdMob application id. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7304740804770627~9735202017" />

        <!-- Hosts long video operations in the background with a progress notification. -->
        <service
            android:name=".operation.OperationService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Guillotine.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Opening a .azp extension package into Guillotine from outside the app. azphalt's
                 spec/store-app.md specifies only the app-to-app BROWSE handoff and states outright that
                 the web storefront case is left unspecified — so azphalt.store can tell a visitor to
                 install a package "from any Azphalt-conforming host" but cannot hand it to one. These
                 filters are the host half of that gap: a .azp downloaded in the browser, sitting in a
                 file manager, or shared from another app can be opened straight into the editor, which
                 re-verifies it (AzpHandoffInstaller) exactly as it does a store app's handoff.

                 Declared on MainActivity rather than a trampoline because the install applies to the
                 project currently on screen; singleTask above routes the open into the running editor. -->
            <intent-filter android:label="@string/azp_open_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.azphalt.package" />
                <!-- application/x-azphalt is now settled upstream as a DEPRECATED ALIAS
                     (spec/package-format.md § Media type): vnd.azphalt.package above is the only
                     normative type, a server MUST NOT send x-azphalt, but a client SHOULD accept it
                     because servers predating that section emit it — the flagship registry still does,
                     verified with curl. So this stays: dropping it would break every download from a
                     registry that hasn't caught up, and matching it costs nothing. Not a validation
                     signal either way — the spec is explicit that a receiver MUST NOT validate on the
                     media type; that's what the manifest digests and the signature are for. -->
                <data android:mimeType="application/x-azphalt" />
            </intent-filter>

            <!-- The other half of the web-storefront gap: an azphalt://install?id=…&version=… deep link.
                 A web page cannot push a .azp into an Android app, so it names the package instead and
                 leaves the fetching to whichever conforming host claims the scheme — MainActivity parses
                 the link and AzphaltStoreScreen downloads it from the registry, then runs the identical
                 verification path a file open or a store-app handoff runs.

                 BROWSABLE because the link is followed from a browser. No package name appears anywhere
                 in the scheme by design: the contract is host-agnostic, so if several conforming hosts
                 are installed Android shows a chooser rather than one of them owning azphalt://. -->
            <intent-filter android:label="@string/azp_open_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="azphalt" android:host="install" />
            </intent-filter>

            <!-- The type the spec says a package SHOULD carry is a hint, not a guarantee, and browser
                 downloads routinely land as octet-stream (or zip — a .azp is a zip container). Match
                 those only when the name actually ends in .azp, so Guillotine doesn't offer itself as an
                 opener for every untyped download. pathPattern is only consulted when a host is present,
                 hence the wildcard. -->
            <intent-filter android:label="@string/azp_open_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:pathPattern=".*\\.azp" />
                <data android:pathPattern=".*\\..*\\.azp" />
                <data android:pathPattern=".*\\..*\\..*\\.azp" />
            </intent-filter>

            <!-- Share-sheet route: "share this .azp with Guillotine" from a browser or files app. Only
                 the explicit azphalt type here — an octet-stream SEND filter would put Guillotine in the
                 share sheet for arbitrary files it can't do anything with. Both azphalt types, for the
                 same reason as the VIEW filter above: x-azphalt is a deprecated alias that servers
                 predating spec/package-format.md § Media type still emit. -->
            <intent-filter android:label="@string/azp_open_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.azphalt.package" />
                <data android:mimeType="application/x-azphalt" />
            </intent-filter>
        </activity>
    </application>

</manifest>
