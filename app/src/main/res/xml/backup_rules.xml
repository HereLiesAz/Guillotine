<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower auto-backup rules (see data_extraction_rules.xml for 12+). Excludes the
     Keystore-encrypted prefs, which can't be decrypted after a restore. -->
<full-backup-content>
    <exclude domain="sharedpref" path="guillotine_secure_settings.xml" />
    <exclude domain="sharedpref" path="guillotine_mcp_secure.xml" />
    <exclude domain="sharedpref" path="guillotine_mcp_relay.xml" />
</full-backup-content>
