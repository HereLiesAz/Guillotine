<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer rules. The EncryptedSharedPreferences files are keyed by a
     Keystore master key that never leaves the device, so a restored copy can't be decrypted — exclude
     them (API keys, the MCP bearer token, the relay access key) from both cloud backup and transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="guillotine_secure_settings.xml" />
        <exclude domain="sharedpref" path="guillotine_mcp_secure.xml" />
        <exclude domain="sharedpref" path="guillotine_mcp_relay.xml" />
        <!-- Large, re-downloadable or device-specific data: models/extensions (hundreds of MB,
             reinstallable), queued crash reports (stale on another device) and learned concepts
             (embeddings tied to this device's on-device models). The project autosave is kept. -->
        <exclude domain="file" path="imported-models" />
        <exclude domain="file" path="azp-models" />
        <exclude domain="file" path="extensions" />
        <exclude domain="file" path="pending_crashes" />
        <exclude domain="file" path="learned_concepts.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="guillotine_secure_settings.xml" />
        <exclude domain="sharedpref" path="guillotine_mcp_secure.xml" />
        <exclude domain="sharedpref" path="guillotine_mcp_relay.xml" />
        <!-- Large, re-downloadable or device-specific data: models/extensions (hundreds of MB,
             reinstallable), queued crash reports (stale on another device) and learned concepts
             (embeddings tied to this device's on-device models). The project autosave is kept. -->
        <exclude domain="file" path="imported-models" />
        <exclude domain="file" path="azp-models" />
        <exclude domain="file" path="extensions" />
        <exclude domain="file" path="pending_crashes" />
        <exclude domain="file" path="learned_concepts.json" />
    </device-transfer>
</data-extraction-rules>
